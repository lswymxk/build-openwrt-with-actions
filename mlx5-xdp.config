# ============================================================================
# ConnectX-6 Lx + 完整 eBPF/XDP（方案 B：CO-RE / BTF / tracing 全开）
#
# 注入方式（工作流里三步，顺序不能变）：
#   1) cat mlx5-xdp.config >> openWRT/.config          ← 包 + 顶层符号 + 内核符号
#   2) (cd openWRT && make defconfig)                  ← 解析依赖、补齐、去重
#   3) grep -E '^(# )?CONFIG_KERNEL_' mlx5-xdp.config >> openWRT/.config
#                                                      ← 再把内核符号补一遍
#
# 为什么第 1 步和第 3 步都要：
#   - defconfig 之前注入，OpenWrt 才能算清 @KERNEL_xxx 这类依赖
#     （例如 kmod-xdp-sockets-diag 依赖 @KERNEL_XDP_SOCKETS）；
#   - defconfig 会重写 .config，只保留它认识的符号；
#     第 3 步在它之后再追加一次，保证所有内核符号都能进入内核 .config。
#
# 第 3 步的 grep 必须能匹配 "# CONFIG_KERNEL_..." 这种注释行，
#   否则 "# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set" 会被漏掉，
#   而它一旦是 y，BTF 就会被内核丢弃。
# ============================================================================


# ---------------------------------------------------------------------------
# 第 1 段：OpenWrt 顶层开关（defconfig 之前注入）
# ---------------------------------------------------------------------------

# 打开"开发者选项"菜单。BPF toolchain 这个 choice 的 prompt 是 "if DEVEL"，
# 不设 DEVEL 的话下面的 BPF_TOOLCHAIN_HOST 会被 kconfig 忽略、回落到默认值。
CONFIG_DEVEL=y

# eBPF 程序用宿主机 LLVM/clang 编译（runner 上 apt 已装 clang/llvm）。
# 不选的话默认走 BPF_TOOLCHAIN_BUILD_LLVM —— 在 CI 里从头编 LLVM，非常慢。
CONFIG_BPF_TOOLCHAIN_HOST=y


# ---------------------------------------------------------------------------
# 第 2 段：软件包（defconfig 之前注入）
# ---------------------------------------------------------------------------

# --- 网卡驱动（ConnectX-6 Lx / MT2892）---
# kmod-ptp、kmod-hwmon-core 是 kmod-mlx5-core 的依赖，会自动选中
CONFIG_PACKAGE_kmod-mlx5-core=y
CONFIG_PACKAGE_kmod-mlxfw=y

# --- 排障 / 调优工具 ---
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_lm-sensors=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_irqbalance=y

# --- eBPF / XDP 用户态工具 ---
# 有 BTF 之后用 bpftool-full：支持 btf dump / gen skeleton / CO-RE
CONFIG_PACKAGE_bpftool-full=y
CONFIG_PACKAGE_libxdp=y
CONFIG_PACKAGE_xdp-loader=y
CONFIG_PACKAGE_xdp-filter=y
CONFIG_PACKAGE_xdpdump=y

# --- tc + eBPF ---
# tc 三选一：tc-tiny / tc-bpf / tc-full（都 PROVIDES tc，不能同时开）
CONFIG_PACKAGE_tc-bpf=y
CONFIG_PACKAGE_kmod-sched-core=y
# 对应下面 NET_CLS_BPF / NET_ACT_BPF 的 =m：dae 的依赖里就有 kmod-sched-bpf，
# 而且内核设成 =y 时不会生成 .ko，这个包会变成空包导致构建报错
CONFIG_PACKAGE_kmod-sched-bpf=y
# AF_XDP 排障用；依赖 @KERNEL_XDP_SOCKETS
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
# dae 的依赖之一（它会在启动时创建 veth 做分流）
CONFIG_PACKAGE_kmod-veth=y

# --- 可选：dae（eBPF 透明代理）---
# 需要上面的 BTF + BPF_EVENTS + tc 模块，以及 BPF_TOOLCHAIN_HOST
# CONFIG_PACKAGE_dae=y
# CONFIG_PACKAGE_dae-geoip=y
# CONFIG_PACKAGE_dae-geosite=y


# ---------------------------------------------------------------------------
# 第 3 段：内核选项（第 1 步先注入一次，defconfig 之后第 3 步再补一次）
#   写法必须是 CONFIG_KERNEL_xxx，OpenWrt 构建时会剥掉前缀注入内核 .config
# ---------------------------------------------------------------------------

# --- eBPF 基础 ---
CONFIG_KERNEL_BPF_SYSCALL=y
CONFIG_KERNEL_BPF_JIT=y
CONFIG_KERNEL_BPF_JIT_ALWAYS_ON=y
CONFIG_KERNEL_CGROUP_BPF=y
# 允许 BPF 程序挂到 kprobe/uprobe/tracepoint/perf event（tracing、bpftool perf 需要）
CONFIG_KERNEL_BPF_EVENTS=y

# --- XDP ---
# AF_XDP：用户态零拷贝收包（xdpdump / 自写 AF_XDP 程序需要）
CONFIG_KERNEL_XDP_SOCKETS=y

# --- tc eBPF（dae 的硬性要求：这三个必须是 m，不能是 y）---
CONFIG_KERNEL_NET_CLS_BPF=m
CONFIG_KERNEL_NET_ACT_BPF=m
CONFIG_KERNEL_NET_SCH_INGRESS=m
CONFIG_KERNEL_NET_CLS_ACT=y
CONFIG_KERNEL_NET_INGRESS=y
CONFIG_KERNEL_NET_EGRESS=y
# dae 用它解析 TCP 流（BPF_PROG_TYPE_SOCKET_FILTER + stream parser）
CONFIG_KERNEL_BPF_STREAM_PARSER=y

# --- tracing（dae trace 需要）---
CONFIG_KERNEL_KPROBES=y
CONFIG_KERNEL_KPROBE_EVENTS=y

# --- BTF / CO-RE（体积和构建时间的主要来源）---
CONFIG_KERNEL_DEBUG_INFO=y
# 必须显式写成注释形式：x86 非 buildbot 时它默认是 y，
# 而 BTF 依赖 DEBUG_INFO_REDUCED=n，不关掉 BTF 会被内核 oldconfig 丢弃
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
