# ============================================================================
# ConnectX-6 Lx + eBPF/XDP 的 .config 增量片段
#
# 这是"网卡 + eBPF/XDP"这部分配置的唯一来源：每次构建自动追加，不用再手选。
#
# 文件分两段，处理时机不同：
#   第 1 段 CONFIG_PACKAGE_*  → 必须在 make defconfig 之前追加（否则依赖不解析）
#   第 2 段 CONFIG_KERNEL_*   → 必须在 make defconfig 之后追加（否则会被 defconfig 丢掉）
#
# 工作流写法（三步）：
#   - run: cat mlx5-xdp.config >> openWRT/.config
#   - run: cd openWRT && make defconfig
#   - run: grep '^CONFIG_KERNEL_' mlx5-xdp.config >> openWRT/.config
# ============================================================================

# ---------------------------------------------------------------------------
# 第 1 段：软件包（make defconfig 之前）
# ---------------------------------------------------------------------------

# --- 0. 网卡驱动（ConnectX-6 Lx / MT2892）---
# kmod-ptp、kmod-hwmon-core 是 kmod-mlx5-core 的依赖，会自动选中，不用写
CONFIG_PACKAGE_kmod-mlx5-core=y
CONFIG_PACKAGE_kmod-mlxfw=y

# --- 1. 排障 / 调优工具 ---
CONFIG_PACKAGE_ethtool=y             # 看驱动/速率/队列，XDP 状态
CONFIG_PACKAGE_lm-sensors=y          # autocore 依赖它（读温度/风扇）
CONFIG_PACKAGE_pciutils=y            # lspci，用来确认 15b3:101d
CONFIG_PACKAGE_irqbalance=y          # 25G 多队列，中断分摊到多核

# --- 2. eBPF / XDP 用户态工具 ---
# bpftool-minimal 够用；要 bpftool gen skeleton / CO-RE 就换 bpftool-full（需内核 BTF）
CONFIG_PACKAGE_bpftool-minimal=y
CONFIG_PACKAGE_libxdp=y
CONFIG_PACKAGE_xdp-loader=y
CONFIG_PACKAGE_xdp-filter=y
CONFIG_PACKAGE_xdpdump=y

# --- 3. tc + eBPF 分类器 ---
# 注意 tc 是三选一：tc-tiny / tc-bpf / tc-full（三者都 PROVIDES tc，不能同时开）。
# 如果基础 .config 里开的是 tc-tiny 或 tc-full，要先把那条改成 is not set。
CONFIG_PACKAGE_tc-bpf=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched-bpf=y
# 依赖 @KERNEL_XDP_SOCKETS；内核那段没生效的话这条会被 defconfig 丢弃
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y

# ---------------------------------------------------------------------------
# 第 2 段：内核选项（make defconfig 之后追加）
#   注意写法是 CONFIG_KERNEL_xxx，不是 CONFIG_xxx。
#   OpenWrt 构建时会剥掉 CONFIG_KERNEL_ 前缀，注入内核的 .config。
#   直接写 CONFIG_XDP_SOCKETS=y 是无效的（OpenWrt 的 kconfig 不认识，静默丢弃）。
# ---------------------------------------------------------------------------
CONFIG_KERNEL_BPF_JIT_ALWAYS_ON=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_NET_CLS_BPF=m
CONFIG_KERNEL_NET_ACT_BPF=m
CONFIG_KERNEL_NET_SCH_INGRESS=m
CONFIG_KERNEL_XDP_SOCKETS=y
# 可选：要让 bpftool 支持 CO-RE / gen skeleton 才开，代价是内核镜像大 5~10MB，
# 且构建机需要 pahole（apt 装 dwarves）
# CONFIG_KERNEL_DEBUG_INFO_BTF=y
